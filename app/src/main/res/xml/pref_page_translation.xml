<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:title="@string/page_translation">

	<ListPreference
		android:icon="@drawable/ic_language"
		android:key="page_translation_provider"
		android:title="@string/page_translation_provider"
		app:useSimpleSummaryProvider="true" />

	<EditTextPreference
		android:key="page_translation_api_key"
		android:summary="@string/page_translation_api_key_summary"
		android:title="@string/page_translation_api_key"
		app:useSimpleSummaryProvider="false" />

	<EditTextPreference
		android:defaultValue="uk"
		android:key="page_translation_target_language"
		android:summary="@string/page_translation_target_language_summary"
		android:title="@string/page_translation_target_language" />

	<EditTextPreference
		android:defaultValue="auto"
		android:key="page_translation_source_language"
		android:summary="@string/page_translation_source_language_summary"
		android:title="@string/page_translation_source_language" />

	<EditTextPreference
		android:key="page_translation_model"
		android:summary="@string/page_translation_model_summary"
		android:title="@string/page_translation_model" />

</PreferenceScreen>
